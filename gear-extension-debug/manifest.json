{
  "manifest_version": 3,
  "name": "X Debug Test (Gear)",
  "version": "1.0.0",
  "description": "Minimal Web Extension debug - only console.log on x.com",
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
