{
  "manifest_version": 3,
  "name": "Twitter/X Timeline Position Saver",
  "version": "3.14",
  "description": "Remembers where you stopped scrolling on the X \"Olo\" timeline and jumps back there on your next visit.",
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "twitter-position-saver@olokkm",
      "update_url": "https://raw.githubusercontent.com/olokkm/twitter-position-saver/main/updates.json"
    }
  }
}
